{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run STASYS App",
            "type": "shell",
            "command": "python",
            "args": ["SL.py"],
            "options": {
                "cwd": "${workspaceFolder}/python_app/stasys_app",
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/python_app"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Run Tests",
            "type": "shell",
            "command": "python",
            "args": ["-m", "pytest", "test/", "-v"],
            "options": {
                "cwd": "${workspaceFolder}/python_app",
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/python_app"
                }
            },
            "problemMatcher": []
        }
    ]
}
